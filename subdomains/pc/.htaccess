DirectorySlash Off

RewriteEngine On

# Protocol detection
RewriteCond %{HTTPS} on [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} https
RewriteRule ^ - [E=REQ_SCHEME:https]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ - [E=REQ_SCHEME:http]

# Preserve client host and port on directory redirects
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ %{ENV:REQ_SCHEME}://%{HTTP_HOST}%{REQUEST_URI}/ [R=301,L]

# Allow access to all files including dotfiles (.git)
<FilesMatch ".*">
    Require all granted
</FilesMatch>

Options +FollowSymLinks +Indexes

