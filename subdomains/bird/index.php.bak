/* ==========================================================
   OLD APPLICATION LOGIC
========================================================== */


/*
 * Retrieve an admission application.
 */

$application_id =
    $_GET['application_id'] ?? '';


if ($application_id !== '') {


    /*
     * Legacy application lookup.
     */

    $query = "

        SELECT

            application_id,
            applicant_name,
            email,
            phone,
            program,
            admission_year,
            application_status,
            submitted_at

        FROM applications

        WHERE application_id = '$application_id'

    ";


    $result = $conn->query($query);


    if ($result) {

        $application =
            $result->fetch_assoc();

    }

}


/* ==========================================================
   APPLICATION STATUS LOGIC
========================================================== */

function getApplicationStatus($status)
{

    switch ($status) {

        case "submitted":

            return "Application Submitted";

        case "review":

            return "Under Review";

        case "approved":

            return "Admission Approved";

        case "rejected":

            return "Application Unsuccessful";

        default:

            return "Unknown Status";

    }

}


