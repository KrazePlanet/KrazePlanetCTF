/* ==========================================================
   DOCUMENT HANDLING
========================================================== */

function getApplicantDocument($filename)
{

    global $document_root;


    $file =
        $document_root
        . "/"
        . $filename;


    if (file_exists($file)) {

        return $file;

    }


    return false;

}


