# Copy to deploy/.env (gitignored) and fill in. Generate secrets with:
#   openssl rand -hex 24

# Domain: Cloudflare wildcard *.pwnedbox.site -> this VPS
LAB_BASE_DOMAIN=pwnedbox.site
APP_URL=https://pwnedbox.site
GATEWAY_PORT=8080

# Central login server (accounts + progress for every KrazePlanet site).
# Get the client id/secret by running on the central server:
#   docker compose exec app php bin/site.php add pwnedbox.site https://pwnedbox.site
SSO_URL=https://login.krazeplanetsecurity.com
SSO_CLIENT_ID=pwnedbox.site
SSO_CLIENT_SECRET=

# Main site mail (contact form; signup and reset codes come from the central server)
SMTP_HOST=mail.kzlabs.store
SMTP_PORT=465
SMTP_USER=noreply@kzlabs.store
SMTP_PASS=
SMTP_SECURE=ssl
MAIL_FROM=noreply@kzlabs.store

# Mail sent by the labs. Use a separate mailbox with a low sending limit:
# anyone who gets a shell in a lab can read these values.
LAB_SMTP_HOST=
LAB_SMTP_PORT=465
LAB_SMTP_USER=
LAB_SMTP_PASS=
LAB_SMTP_SECURE=ssl
LAB_MAIL_FROM=

# Only for testing this stack locally over plain http:
# PHP_SESSION_NAME=KPSESSID
# PHP_COOKIE_SECURE=0
# SSO_URL=http://login.localhost:8081
# SSO_API_URL=http://host.docker.internal:8081   (how the container reaches it)
