# Ultra-fast micro-container base for KrazePlanet Isolated Labs
FROM php:8.2-apache

# Install essentials and extensions in one layer
RUN apt-get update && apt-get install -y --no-install-recommends \
    libsqlite3-dev \
    libpng-dev \
    libjpeg-dev \
    libxml2-dev \
    libzip-dev \
    python3 \
    python3-pip \
    python3-jinja2 \
    python3-tornado \
    python3-requests \
    curl \
    && docker-php-ext-install -j$(nproc) mysqli pdo pdo_mysql pdo_sqlite gd zip xml \
    && a2enmod rewrite headers env dir \
    && rm -rf /var/lib/apt/lists/*

# Configure Apache & PHP settings
RUN sed -i 's/AllowOverride None/AllowOverride All/g' /etc/apache2/apache2.conf \
    && echo 'ServerName localhost' >> /etc/apache2/apache2.conf \
    && echo 'DirectoryIndex index.php index.html' >> /etc/apache2/apache2.conf \
    && echo '<Directory /var/www/html>' >> /etc/apache2/apache2.conf \
    && echo '    Options Indexes FollowSymLinks MultiViews' >> /etc/apache2/apache2.conf \
    && echo '    AllowOverride All' >> /etc/apache2/apache2.conf \
    && echo '    Require all granted' >> /etc/apache2/apache2.conf \
    && echo '</Directory>' >> /etc/apache2/apache2.conf

# Security & Error configuration
RUN { \
        echo 'short_open_tag = On'; \
        echo 'display_errors = On'; \
        echo 'display_startup_errors = On'; \
        echo 'error_reporting = E_ALL & ~E_NOTICE & ~E_DEPRECATED & ~E_STRICT'; \
        echo 'upload_max_filesize = 128M'; \
        echo 'post_max_size = 128M'; \
        echo 'memory_limit = 256M'; \
        echo 'mysqli.default_host = krazeplanet'; \
        echo 'pdo_mysql.default_host = krazeplanet'; \
        echo 'pdo_mysql.default_socket = /var/run/mysqld/mysqld.sock'; \
        echo 'mysql.default_socket = /var/run/mysqld/mysqld.sock'; \
    } > /usr/local/etc/php/conf.d/kraze-lab.ini

WORKDIR /var/www/html

EXPOSE 80

CMD ["apache2-foreground"]
